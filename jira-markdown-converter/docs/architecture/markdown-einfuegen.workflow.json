  "cards": [
    {
      "dot": "cyan",
      "title": "Vier Ausloeser, ein Weg",
      "items": [
        "Kuerzel und Kontextmenue laufen ueber den Service-Worker, der die Nachricht schickt und die Content-Scripts bei Bedarf erst injiziert",
        "Das Popup schickt insert-text an das gemerkte Zielfeld, das Einfuegen mit Strg+V faengt das Content-Script direkt ab",
        "Ohne freigegebenen Host gibt es keinen Empfaenger - das Popup bietet die Freigabe an, bevor irgendetwas laeuft"
      ]
    },
    {
      "dot": "emerald",
      "title": "Weichen vor dem Schreiben",
      "items": [
        "looksLikeMarkdown() entscheidet, ob die Automatik ueberhaupt eingreift",
        "Reines Textfeld bekommt Wiki-Markup; bei aktivem Rich-Text-Editor entscheidet switchToMarkup und danach richEditorFormat",
        "insertModeFor() waehlt block oder inline"
      ]
    },
    {
      "dot": "rose",
      "title": "Abbrueche bleiben sichtbar",
      "items": [
        "Fertiges Jira-Markup wird nicht ein zweites Mal umgewandelt, sondern unveraendert eingefuegt",
        "Nach preventDefault() darf nichts stillschweigend verschwinden: scheitert die Umwandlung, sagt ein Hinweis Bescheid",
        "Ohne Zielfeld endet der Weg mit einer Meldung, nicht mit einem Schreibversuch"
      ]
    }
  ]
