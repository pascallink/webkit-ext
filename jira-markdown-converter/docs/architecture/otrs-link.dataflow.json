  "cards": [
    {
      "dot": "cyan",
      "title": "Was aus der Eingabe wird",
      "items": [
        "Ticketnummer aus Ticket#<nummer> im Titel oder TicketNumber=<nummer> in der Adresse - ohne Nummer oder ohne gueltige URL bricht parse() ab",
        "label ist die Ticketnummer, reference und linkText sind derselbe Titel, url die bereinigte Adresse",
        "stripTags() ersetzt bis zum Fixpunkt und wertet nie innerHTML aus"
      ]
    },
    {
      "dot": "emerald",
      "title": "Strikt in dieser Reihenfolge",
      "items": [
        "Label, dann Kunden Referenz, dann Web-Link - dazwischen je 150 ms Pause ueber JiraUi.delay",
        "Jeder Schritt versucht zuerst das Tastenkuerzel (1500 ms), danach den sichtbaren DOM-Trigger (5000 ms)",
        "Nichts laeuft ueber HTTP: JiraUi bedient nur das DOM der offenen Seite, window.JIRA sieht die isolierte Welt nie"
      ]
    },
    {
      "dot": "rose",
      "title": "Wenn ein Schritt scheitert",
      "items": [
        "Der Fehler traegt den Schritt - bereits gesetzte Werte bleiben stehen, es gibt kein Zuruecknehmen",
        "War die Kunden Referenz belegt, meldet ein bleibender Hinweis den alten Wert",
        "Der Dialog bleibt offen, damit die Eingabe nicht verloren geht"
      ]
    }
  ]
