  "cards": [
    {
      "dot": "cyan",
      "title": "Grenzen der Optionsseite",
      "items": [
        "50 Vorlagen, 5000 Zeichen Markup, 60 Zeichen Titel, 5 Platzhalter je Vorlage",
        "Ein Platzhalter im Markup ohne Eintrag in der Liste ist nur ein Hinweis, kein Abbruch",
        "Loeschen fragt nach und speichert danach dieselbe Liste ohne den Eintrag"
      ]
    },
    {
      "dot": "emerald",
      "title": "Zwei Bereiche, ein Speichern",
      "items": [
        "Alles ausser customTemplates geht nach chrome.storage.sync, die Vorlagen selbst nach local - sync erlaubt nur 8192 Byte je Item",
        "save() schreibt beide Bereiche getrennt; die Toggles und Hosts speichern verzoegert nach 400 ms"
      ]
    },
    {
      "dot": "rose",
      "title": "Ankommen im offenen Tab",
      "items": [
        "chrome.storage.onChanged weckt jeden Kontext - 50 ms Debounce fasst die zwei Ereignisse eines Speicherns zusammen",
        "Danach laedt der Tab die Einstellungen neu und baut Vorlagenmenue, Leistenknoepfe und den schwebenden Knopf neu auf",
        "Kein Nachladen der Seite noetig - ein Neustart des Tabs ist nur bei geaenderten Hosts noetig"
      ]
    }
  ]
