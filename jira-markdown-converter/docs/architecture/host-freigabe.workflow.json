  "cards": [
    {
      "dot": "cyan",
      "title": "Zwei Freigabe-Wege",
      "items": [
        "host_permissions deckt nur *.atlassian.net ab, jede andere Adresse startet in optional_host_permissions",
        "Popup bietet die Freigabe nur an, wenn der Ping auf den aktiven Tab fehlschlaegt",
        "Die Optionsseite hat ein eigenes Adressfeld, unabhaengig vom gerade offenen Tab"
      ]
    },
    {
      "dot": "emerald",
      "title": "Registrierung folgt Ereignissen",
      "items": [
        "permissions.onAdded/onRemoved und die Aenderung von extraHosts loesen syncExtraHosts() aus",
        "contains() prueft vor jedem register/unregisterContentScripts erneut",
        "Eine leere Hostliste ruft unregisterContentScripts statt eines leeren Musters"
      ]
    },
    {
      "dot": "rose",
      "title": "Abbrueche bleiben sichtbar",
      "items": [
        "Lehnt der Nutzer den Browser-Dialog ab, endet der Weg ohne weitere Aktion",
        "contains() = false in syncExtraHosts bricht die Registrierung kommentarlos ab",
        "probeJira erkennt fremde Seiten und laedt STANDALONE_FILES statt CONTENT_FILES"
      ]
    }
  ]
