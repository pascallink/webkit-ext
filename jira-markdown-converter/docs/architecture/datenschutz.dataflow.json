  "cards": [
    {
      "dot": "cyan",
      "title": "Was verarbeitet wird",
      "items": [
        "Zwischenablage und Feldinhalt durchlaufen den Konverter nur im Speicher der Seite",
        "OTRS-Eingabe fuellt Label, Kunden Referenz und Web-Link direkt im Jira-Formular",
        "Einstellungen und eigene Vorlagen liegen in chrome.storage, sync bzw. local"
      ]
    },
    {
      "dot": "emerald",
      "title": "Berechtigungen aus manifest.json",
      "items": [
        "Permissions: activeTab, storage, contextMenus, scripting - keine Netzwerk-Permission",
        "host_permissions deckt nur https://*.atlassian.net/*; optional_host_permissions steht auf *://*/*, freigegeben wird aber immer nur die Adresse, die der Nutzer selbst bestaetigt",
        "Kein eval, kein new Function, keine externen Skripte oder Stylesheets"
      ]
    },
    {
      "dot": "rose",
      "title": "Die einzige Ausnahme",
      "items": [
        "Kein fetch, kein XMLHttpRequest, keine Telemetrie in der Erweiterung selbst",
        "Kein Pfad in diesem Diagramm verlaesst chrome.storage, das DOM oder die Zwischenablage",
        "chrome.storage.sync synct nur ueber das Microsoft- bzw. Google-Konto - das macht Chrome, nicht die Erweiterung"
      ]
    }
  ]
